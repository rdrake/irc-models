#!/bin/bash
# Scrub what is about to be committed: the index's copy of each staged file,
# not the working tree's (see ci/scrub.py).
# Install: ln -s ../../ci/pre-commit .git/hooks/pre-commit
# and point SCRUB_DENYLIST at your copy of the deny list.
exec python3 "$(git rev-parse --show-toplevel)/ci/scrub.py" --staged
